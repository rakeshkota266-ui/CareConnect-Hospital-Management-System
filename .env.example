# Copy this file to /etc/careconnect/careconnect.env on the EC2 instance.
# Replace SECRET_KEY with a freshly generated value; never commit the real .env.
CARECONNECT_ENV=production
SECRET_KEY=
DATABASE_URL=sqlite:////var/lib/careconnect/careconnect.db
UPLOAD_FOLDER=/var/lib/careconnect/uploads
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
